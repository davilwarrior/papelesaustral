# =============================================================
# Papeles Austral: variables de entorno
# Copia este archivo a .env (o .env.local) y llena los valores reales.
# Nunca subas .env al repositorio.
# =============================================================

# -------------------------------------------------------------
# Base de datos (Neon Postgres)
# Neon Console > tu proyecto > Connect
# -------------------------------------------------------------
# Conexión con pooling (host con "-pooler"): la usa la app en runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Conexión directa (host sin "-pooler"): para migraciones del esquema
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# -------------------------------------------------------------
# Google Sheets API (cuenta de servicio)
# Google Cloud Console > IAM > Cuentas de servicio > Claves > JSON
# Comparte el Sheet con GOOGLE_SERVICE_ACCOUNT_EMAIL como "Lector".
# -------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="papeles-austral-sync@tu-proyecto.iam.gserviceaccount.com"
# Copia el campo "private_key" del JSON tal cual, con los \n y entre comillas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID del Sheet: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
# Pestaña del catálogo (con comillas simples si tiene espacios). La fila de encabezados se detecta sola.
GOOGLE_SHEETS_RANGE="'CATALOGO PCC GRAFICO'!A1:Z"

# -------------------------------------------------------------
# Sincronización Sheet -> Neon
# -------------------------------------------------------------
# Secreto que envía Apps Script al webhook /api/sync/prices
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_WEBHOOK_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
# Secreto del Cron de Vercel (Vercel lo envía como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="cambia-esto-por-otro-valor-aleatorio-largo"

# -------------------------------------------------------------
# Asistente de chat (OpenAI)
# platform.openai.com > API keys. Pon un límite de gasto en Settings > Limits.
# -------------------------------------------------------------
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"
# Opcional: cambia el modelo sin tocar código (por defecto gpt-6-luna)
# OPENAI_CHAT_MODEL="gpt-6-luna"
# Opcional: modelo para transcribir notas de voz de WhatsApp (por defecto gpt-transcribe)
# OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"

# -------------------------------------------------------------
# WhatsApp (Kapso, modo dual): el asistente responde por WhatsApp.
# Kapso > número > Webhooks (formato de Kapso, con "Debounce rapid messages" activado)
#   URL: https://www.papelesaustral.com/api/whatsapp/webhook (con www: sin www hay un 308 que Kapso no sigue)
#   Secret key: el mismo valor de WHATSAPP_WEBHOOK_SECRET
# -------------------------------------------------------------
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WEBHOOK_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
# Kapso > API keys (para enviar las respuestas)
KAPSO_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# Kapso > Phone numbers > Phone number ID (se ignoran eventos de otros números)
WHATSAPP_PHONE_NUMBER_ID="000000000000000"
# Opcional: horas que el bot se calla en un chat cuando escribe un asesor desde la app (por defecto 4)
# WHATSAPP_AGENT_PAUSE_HOURS="4"
# Opcional: horas que el bot se calla después de pasar la conversación a un asesor (por defecto 12; 0 para pruebas)
# WHATSAPP_HANDOFF_PAUSE_HOURS="12"
# Opcional: días sin actividad tras los que se borran las conversaciones (por defecto 90; Cron diario)
# WHATSAPP_RETENTION_DAYS="90"
# Opcional: días sin atención además de los feriados nacionales (feriados locales, vacaciones)
# BUSINESS_EXTRA_HOLIDAYS="2027-04-12,2027-12-24"

# -------------------------------------------------------------
# Correo (Resend): aviso al asesor cuando el bot de WhatsApp le pasa un cliente.
# resend.com > API Keys. Verifica el dominio en Domains para enviar desde él;
# sin dominio verificado, Resend solo envía a la dirección de tu propia cuenta.
# Si falta RESEND_API_KEY o ADVISOR_EMAIL_TO, el aviso solo queda en los logs.
# -------------------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Uno o varios correos separados por coma
# ADVISOR_EMAIL_TO="ventas@papelesaustral.com"
# ADVISOR_EMAIL_FROM="Asistente Papeles Austral <asistente@papelesaustral.com>"
# AÚN NO SE USAN (el pedido web va solo por WhatsApp):
# QUOTE_EMAIL_FROM="Papeles Austral <pedidos@papelesaustral.com>"
# QUOTE_EMAIL_TO="ventas@papelesaustral.com"
